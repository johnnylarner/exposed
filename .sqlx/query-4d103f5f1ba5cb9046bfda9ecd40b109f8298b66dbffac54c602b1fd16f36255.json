  "query": "SELECT parliament_member_id, name, party_id, party_name, membership_from AS latest_membership_from, membership_kind, membership_end_date\n             FROM exposed.members m  WHERE parliament_member_id = $1 AND (m.membership_kind = $2 AND m.membership_end_date IS NULL OR EXISTS (SELECT 1 FROM exposed.declarations d WHERE d.member_id = m.id))",
