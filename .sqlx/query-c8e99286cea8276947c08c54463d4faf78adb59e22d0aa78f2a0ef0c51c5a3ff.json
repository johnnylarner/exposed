  "query": "SELECT m.parliament_member_id, m.name, m.party_id, m.party_name, m.membership_from AS latest_membership_from, k.name AS membership_kind, m.membership_end_date\n             FROM exposed.members m JOIN exposed.membership_kinds k ON k.id = m.membership_kind WHERE parliament_member_id = $1 AND (k.name = $2 AND m.membership_end_date IS NULL OR EXISTS (SELECT 1 FROM exposed.declarations d WHERE d.member_id = m.id))",
