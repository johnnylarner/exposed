# PostHog configuration
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Server-only feedback email configuration. Both values are required.
# The onboarding sender can only deliver to the Resend account email.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
